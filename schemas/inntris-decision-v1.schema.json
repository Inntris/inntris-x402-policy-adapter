              "KYA_PROOF_INVALID",
              "KYA_PROOF_REPLAYED",
              "KYA_AGENT_IDENTITY_MISMATCH",
              "KYA_DELEGATION_INVALID",
              "KYA_DELEGATION_SIGNATURE_INVALID",
              "KYA_DELEGATION_EXPIRED",
              "KYA_DELEGATION_REVOKED",
              "KYA_REVOCATION_UNAVAILABLE",
              "KYA_ACTION_NOT_DELEGATED",
