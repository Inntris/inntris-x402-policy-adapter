        "verdict": { "type": "string", "enum": ["ALLOW", "BLOCK", "REQUIRE_APPROVAL"] },
        "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action_type": { "type": "string", "const": "financial_transaction" },
        "action_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "transaction": {
          "type": "object",
          "properties": {
            "amount": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.\\d{2,18}$" },
            "asset": { "type": "string", "minLength": 1, "maxLength": 128 },
            "network": { "type": "string", "minLength": 1, "maxLength": 128 },
            "payee": { "type": "string", "minLength": 1, "maxLength": 512 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["amount", "asset", "network", "payee", "purpose"],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["policy_hash", "policy_version"],
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["policy_engine", "human"] },
            "approval_reference": {
              "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }]
            },
            "approver_ids": {
              "maxItems": 32,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          },
          "required": ["mode", "approval_reference", "approver_ids"],
          "additionalProperties": false
        },
        "reason_codes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MERCHANT_ALLOWED",
