{
  "$id": "https://schemas.inntris.com/inntris-a2a-action-binding-v1.schema.json",
  "title": "Inntris A2A Action Binding v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "string", "const": "inntris-a2a-binding-v1" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "context_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payment_submission_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payment_requirements_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource": { "type": "string", "format": "uri" },
    "required_finality": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": [
    "version",
    "task_id",
    "context_id",
    "payment_submission_id",
    "payment_requirements_hash",
    "resource",
    "required_finality"
  ],
  "additionalProperties": false
}
