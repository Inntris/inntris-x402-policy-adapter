{
  "$id": "https://schemas.inntris.com/inntris-action-v1.schema.json",
  "title": "Inntris Action v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": { "type": "string", "const": "inntris-action-v1" },
        "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action_type": { "type": "string", "const": "financial_transaction" },
        "transaction": {
          "type": "object",
          "properties": {
            "amount": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.\\d{2,18}$" },
            "asset": { "type": "string", "minLength": 1, "maxLength": 128 },
            "network": { "type": "string", "minLength": 1, "maxLength": 128 },
            "payee": { "type": "string", "minLength": 1, "maxLength": 512 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["amount", "asset", "network", "payee", "purpose"],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "rail": { "type": "string", "const": "x402" },
        "protocol_reference": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "x402" },
            "resource": { "type": "string", "format": "uri" },
            "scheme": { "type": "string", "minLength": 1, "maxLength": 64 },
            "payment_requirements_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "payment_payload_hash": {
              "anyOf": [
                { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "type",
            "resource",
            "scheme",
            "payment_requirements_hash",
            "payment_payload_hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "principal_id",
        "agent_id",
        "action_type",
        "transaction",
        "rail",
        "protocol_reference"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": { "type": "string", "const": "inntris-action-v1" },
        "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action_type": { "type": "string", "const": "financial_transaction" },
        "transaction": {
          "type": "object",
          "properties": {
            "amount": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.\\d{2,18}$" },
            "asset": { "type": "string", "minLength": 1, "maxLength": 128 },
            "network": { "type": "string", "minLength": 1, "maxLength": 128 },
            "payee": { "type": "string", "minLength": 1, "maxLength": 512 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["amount", "asset", "network", "payee", "purpose"],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "rail": { "type": "string", "const": "ap2" },
        "protocol_reference": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "ap2" },
            "protocol_version": { "type": "string", "const": "0.2" },
            "resource": { "type": "string", "format": "uri" },
            "mode": { "type": "string", "const": "autonomous" },
            "intent_verification_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "checkout_mandate_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "payment_mandate_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "checkout_hash": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
            "transaction_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" }
          },
          "required": [
            "type",
            "protocol_version",
            "resource",
            "mode",
            "intent_verification_hash",
            "checkout_mandate_hash",
            "payment_mandate_hash",
            "checkout_hash",
            "transaction_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "principal_id",
        "agent_id",
        "action_type",
        "transaction",
        "rail",
        "protocol_reference"
      ],
      "additionalProperties": false
    }
  ]
}
