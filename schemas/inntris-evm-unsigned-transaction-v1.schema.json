{
  "$id": "https://schemas.inntris.com/inntris-evm-unsigned-transaction-v1.schema.json",
  "title": "Inntris EVM Unsigned Transaction v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["eip1559", "legacy"] },
    "chain_id": { "type": "string", "pattern": "^[1-9]\\d*$" },
    "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value_wei": { "type": "string", "pattern": "^(0|[1-9]\\d*)$" },
    "data": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
    "nonce": { "type": "string", "pattern": "^(0|[1-9]\\d*)$" },
    "gas_limit": { "type": "string", "pattern": "^[1-9]\\d*$" },
    "max_fee_per_gas_wei": {
      "anyOf": [{ "type": "string", "pattern": "^(0|[1-9]\\d*)$" }, { "type": "null" }]
    },
    "max_priority_fee_per_gas_wei": {
      "anyOf": [{ "type": "string", "pattern": "^(0|[1-9]\\d*)$" }, { "type": "null" }]
    },
    "gas_price_wei": {
      "anyOf": [{ "type": "string", "pattern": "^(0|[1-9]\\d*)$" }, { "type": "null" }]
    },
    "access_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "storage_keys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
          }
        },
        "required": ["address", "storage_keys"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "chain_id",
    "from",
    "to",
    "value_wei",
    "data",
    "nonce",
    "gas_limit",
    "max_fee_per_gas_wei",
    "max_priority_fee_per_gas_wei",
    "gas_price_wei",
    "access_list"
  ],
  "additionalProperties": false
}
