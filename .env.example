# Normal API startup requires exactly one local, managed or explicit demo signing source.
# The seed is 32 random bytes encoded as base64url without padding.
INNTRIS_SIGNING_SEED_BASE64URL=
INNTRIS_SIGNING_SEED_FILE=
INNTRIS_SIGNING_KEY_ID=dev-key-1
INNTRIS_KEY_REGISTRY_FILE=
INNTRIS_MANAGED_SIGNER_URL=
INNTRIS_MANAGED_SIGNER_BEARER_TOKEN=
INNTRIS_MANAGED_SIGNER_PUBLIC_KEY_BASE64URL=
INNTRIS_POLICY_FILE=policies/demo-x402-policy.yml
INNTRIS_API_HOST=127.0.0.1
INNTRIS_API_PORT=3402
INNTRIS_SERVICE_API_KEY=

# Optional durable state. Apply migrations with `pnpm postgres:migrate` before startup.
INNTRIS_POSTGRES_URL=

# Optional existing MTP authority. Enabling it requires PostgreSQL and exactly one MTP signing seed source.
INNTRIS_MTP_API_URL=
INNTRIS_MTP_AGENT_ID=
INNTRIS_MTP_SIGNING_SEED_BASE64URL=
INNTRIS_MTP_SIGNING_SEED_FILE=
INNTRIS_MTP_SIGNING_KEY_ID=mtp-agent-key-1
INNTRIS_MTP_POLICY_HASH=
INNTRIS_MTP_MANAGED_SIGNER_URL=
INNTRIS_MTP_MANAGED_SIGNER_BEARER_TOKEN=
INNTRIS_MTP_MANAGED_SIGNER_PUBLIC_KEY_BASE64URL=

# Explicitly opt into the public, non-production demo key.
INNTRIS_DEMO_MODE=false

# Remote provider settings.
INNTRIS_API_URL=
INNTRIS_API_KEY=
INNTRIS_KEY_REGISTRY_URL=
INNTRIS_EXPECTED_POLICY_VERSION=1
