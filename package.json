{
  "name": "inntris-x402-policy-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "A rail-independent Inntris Decision Envelope and fail-closed x402 policy adapter.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.18.1 <11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "demo": "pnpm build && node examples/local-x402/dist/demo.js",
    "demo:api": "pnpm build && node apps/demo-api/dist/start.js",
    "evidence:generate": "pnpm build && node scripts/dist/generate-evidence.js",
    "evidence:verify": "pnpm build && node scripts/dist/verify-evidence.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate:dev": "pnpm build && node scripts/dist/generate-dev-key.js",
    "lint": "eslint .",
    "schemas:generate": "pnpm build && node scripts/dist/generate-schemas.js",
    "test": "pnpm build && vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:unit": "pnpm build && vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inntris/decision-core": "workspace:*",
    "@inntris/decision-verifier": "workspace:*",
    "@inntris/policy-engine": "workspace:*",
    "@inntris/x402-adapter": "workspace:*",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.8.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
